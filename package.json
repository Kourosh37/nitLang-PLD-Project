{
  "name": "nitlang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "nitlang": "bun src/cli/main.ts",
    "build:windows": "bun build --compile --target=bun-windows-x64-baseline --outfile dist/windows-x64/nitlang.exe src/cli/main.ts",
    "build:linux": "bun build --compile --target=bun-linux-x64-baseline --outfile dist/linux-x64/nitlang src/cli/main.ts",
    "build:linux:arm64": "bun build --compile --target=bun-linux-arm64 --outfile dist/linux-arm64/nitlang src/cli/main.ts",
    "build:macos": "bun build --compile --target=bun-darwin-arm64 --outfile dist/macos-arm64/nitlang src/cli/main.ts",
    "build:macos:x64": "bun build --compile --target=bun-darwin-x64-baseline --outfile dist/macos-x64/nitlang src/cli/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "bun run format:check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "^3.9.8",
    "typescript": "5.9.3"
  }
}
