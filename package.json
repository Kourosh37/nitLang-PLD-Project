{
  "name": "nitlang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "nitlang": "bun src/cli/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "bun run format:check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "^3.9.8",
    "typescript": "5.9.3"
  }
}
